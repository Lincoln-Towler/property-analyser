    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst observations = data.dataSets[0].observations;\nconst timePeriods = data.structure.dimensions.observation[7].values;\n\n// Sort to get most recent quarter\nconst sorted = timePeriods\n  .map((t, i) => ({ date: t.id, index: i }))\n  .sort((a, b) => b.date.localeCompare(a.date));\n\nconst latestIndex = sorted[0].index;\nconst latestDate = sorted[0].date;\n\n// MEASURE=3(idx1), INDEX=THRPIB(idx0), SECTOR=PrivatePublic(idx1), INDUSTRY=TOT(idx0), TSEST=Original(idx0), REGION=AUS(idx0), FREQ=Q(idx0)\nconst key = `1:0:1:0:0:0:0:${latestIndex}`;\nconst value = observations[key][0];\n\n// Convert quarter to date\nconst [year, q] = latestDate.split('-Q');\nconst month = (parseInt(q) * 3).toString().padStart(2, '0');\nconst date = `${year}-${month}-01`;\n\nreturn [{ json: { value: parseFloat(value.toFixed(1)), date } }];"
      },
